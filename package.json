{
  "name": "primary-school-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Primary School Management System — REST API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrate.ts up",
    "migrate:down": "tsx src/database/migrate.ts down",
    "migrate:status": "tsx src/database/migrate.ts status",
    "seed": "tsx src/database/seeds/index.ts",
    "seed:population": "tsx src/database/seeds/population.ts",
    "seed:activity": "tsx src/database/seeds/activity.ts",
    "seed:roster": "tsx src/database/seeds/roster.ts",
    "seed:timetable": "tsx src/database/seeds/timetable.ts",
    "seed:school-life": "tsx src/database/seeds/school-life.ts",
    "seed:current-year": "tsx src/database/seeds/current-year.ts",
    "seed:verify": "tsx src/database/seeds/verify.ts",
    "seed:reset-school": "tsx src/database/seeds/reset-school.ts",
    "mail:test": "tsx src/database/seeds/mail-test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
