# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hun_sen_turey
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-this-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@school.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- Outgoing mail -----------------------------------------------------------
# Used for the password reset code. Leave SMTP_HOST empty in development: the
# mailer then logs the message (code included) instead of sending it, and the
# code also comes back in the API response outside production.
#
# For Gmail you must use an App Password, not the account password, and the
# account needs 2-Step Verification switched on:
#   Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=audioplay98@gmail.com
SMTP_PASSWORD=dadad
MAIL_FROM_NAME=Hun Sen Turey Secondary School
MAIL_FROM_ADDRESS=your.school@gmail.com

# Emailed reset code
PASSWORD_RESET_CODE_LENGTH=6
PASSWORD_RESET_MAX_ATTEMPTS=5

# Homework attachments (photos, PDFs) are stored on disk, not in the database
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
